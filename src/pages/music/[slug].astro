---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import AppleMusicEmbed from '../../components/ui/AppleMusicEmbed.astro';
import StreamingLinks from '../../components/ui/StreamingLinks.astro';
import WaveDivider from '../../components/ui/WaveDivider.astro';
import { formatDate } from '../../utils/formatDate';

export async function getStaticPaths() {
  const releases = await getCollection('releases');
  return releases.map((release) => ({
    params: { slug: release.slug },
    props: { release },
  }));
}

const { release } = Astro.props;
const { Content } = await release.render();

const typeLabels = {
  album: 'Album',
  single: 'Single',
  ep: 'EP',
};

const typeColors = {
  album: 'text-brand-red',
  single: 'text-brand-blue',
  ep: 'text-brand-teal',
};
---

<Layout
  title={`${release.data.title} - Mix n Blend`}
  description={release.data.description ??
    `${release.data.title} by Mix n Blend — ${typeLabels[release.data.type]} released ${formatDate(release.data.releaseDate)}`}
  image={release.data.artwork}
  type="website"
>
  <div class="bg-brand-off-white py-10">
    <div class="container mx-auto px-4">
      <a
        href="/music/"
        class="inline-flex items-center gap-2 font-display font-semibold lowercase text-brand-blue transition-colors hover:text-brand-red"
      >
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
        </svg>
        all music
      </a>
    </div>
  </div>

  <WaveDivider color="white" />

  <section class="bg-white py-12">
    <div class="container mx-auto px-4">
      <div class="mx-auto max-w-5xl">
        <div class="grid gap-10 md:grid-cols-2">
          <!-- Artwork -->
          <div>
            <img
              src={release.data.artwork}
              alt={`${release.data.title} artwork`}
              class="shadow-playful w-full rounded-card"
            />
          </div>

          <!-- Info -->
          <div class="flex flex-col gap-4">
            <div>
              <span
                class={`font-display text-sm font-bold uppercase tracking-widest ${typeColors[release.data.type]}`}
              >
                {typeLabels[release.data.type]}
                {
                  release.data.label && (
                    <span class="ml-2 font-normal normal-case text-gray-400">
                      · {release.data.label}
                    </span>
                  )
                }
              </span>
              <h1
                class="font-display mt-2 text-4xl font-bold lowercase text-brand-dark md:text-5xl"
              >
                {release.data.title}
              </h1>
              <time class="mt-1 block text-sm text-gray-500">
                {release.data.year}
              </time>
            </div>

            {
              release.data.description && (
                <p class="font-body text-lg leading-relaxed text-gray-700">
                  {release.data.description}
                </p>
              )
            }

            {
              release.data.credits && (
                <p class="text-sm text-gray-500">
                  <span class="font-semibold">Credits:</span> {release.data.credits}
                </p>
              )
            }

            <!-- Streaming links -->
            {
              release.data.streamingLinks && (
                <div>
                  <p class="mb-3 font-display text-sm font-bold uppercase tracking-widest text-gray-400">
                    listen on
                  </p>
                  <StreamingLinks links={release.data.streamingLinks} size="medium" />
                </div>
              )
            }

            <!-- Track list -->
            {
              release.data.trackList && (
                <div>
                  <p class="mb-3 font-display text-sm font-bold uppercase tracking-widest text-gray-400">
                    tracklist
                  </p>
                  <ol class="space-y-2">
                    {release.data.trackList.map((track, index) => (
                      <li class="flex justify-between gap-4 border-b border-brand-warm-grey py-2 text-sm">
                        <span class="text-brand-dark">
                          <span class="mr-2 font-semibold text-brand-blue">{index + 1}.</span>
                          {track.title}
                          {track.features && (
                            <span class="ml-1 text-gray-400">{track.features}</span>
                          )}
                        </span>
                        <span class="shrink-0 text-gray-400">{track.duration}</span>
                      </li>
                    ))}
                  </ol>
                </div>
              )
            }
          </div>
        </div>

        <!-- Apple Music embed -->
        {
          release.data.streamingLinks?.apple && (
            <div class="mt-12">
              <p class="mb-4 font-display text-sm font-bold uppercase tracking-widest text-gray-400">
                preview
              </p>
              <AppleMusicEmbed
                url={release.data.streamingLinks.apple}
                title={release.data.title}
                height={release.data.type === 'album' ? 450 : 175}
              />
            </div>
          )
        }

        <!-- Markdown body (if any extra content) -->
        <div class="prose prose-lg mx-auto mt-10 font-body">
          <Content />
        </div>
      </div>
    </div>
  </section>
</Layout>
