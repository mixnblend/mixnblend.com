---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/sections/Hero.astro';
import DiscographySection from '../components/sections/DiscographySection.astro';
---

<Layout
  title="Music - Mix n Blend"
  description="Explore Mix n Blend's discography featuring reggae, hip hop, jazz, funk, and dubstep."
>
  <Hero title="Music" subtitle="Our Discography" height="small" />

  <DiscographySection />

  <section class="py-16 bg-gray-50">
    <div class="container mx-auto px-4 text-center">
      <h2 class="text-2xl font-bold mb-4">Find Us On Streaming Platforms</h2>
      <p class="text-gray-600 mb-6">Listen to Mix n Blend on your favorite streaming service</p>
      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="https://www.discogs.com/artist/1358150-Mix-N-Blend"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center px-6 py-3 bg-white border border-gray-300 rounded-md font-medium text-gray-700 hover:bg-gray-50 transition-colors"
        >
          Discogs
        </a>
      </div>
    </div>
  </section>
</Layout>
