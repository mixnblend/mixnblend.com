---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/sections/Hero.astro';
import WaveDivider from '../components/ui/WaveDivider.astro';
---

<Layout
  title="About - Mix n Blend"
  description="Mix n Blend started in 2001 when Jon and Kev began making beats together in Cape Town. Now a 9-piece live band blending dub, reggae, drum n bass, funk, swing, and glitch hop."
>
  <Hero title="about the band" height="medium" backgroundImage="/images/band/about.jpg" />

  <WaveDivider color="white" />

  <section class="bg-white py-16">
    <div class="container mx-auto px-4">
      <div class="mx-auto max-w-3xl">
        <div class="font-body space-y-6 text-xl leading-relaxed">
          <p>15 years ago, we saw Krushed &amp; Sorted playing a show, and it changed our lives.</p>
          <p>
            Since then we've made music as a DJ and production duo, played countless gigs up and
            down the country — everything from big band swing to drum &amp; bass. We've produced
            music for a bunch of TV commercials.
          </p>
          <p>
            We've morphed into a 9-piece band with one of the best horn sections out there, two
            incredible vocalists, a VJ, a drummer and a guitarist who have all done incredible
            things in their own right.
          </p>
          <p>
            We're a big musical family. We like to travel and we like to meet people through music
            and have a good time. That's the purpose of life in the end — to connect with good
            people, to share experiences with them, and to learn from them and to grow.
          </p>
        </div>
      </div>
    </div>
  </section>

  <WaveDivider color="blue" flip={true} />

  <section class="bg-brand-blue py-16 text-white">
    <div class="container mx-auto px-4">
      <h2 class="font-display mb-12 text-center text-4xl font-bold lowercase">the band</h2>
      <div class="mx-auto grid max-w-6xl gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          [
            {
              name: 'Jonathan Arnold',
              position: 'producer, saxophone',
              img: '/images/band/jon.jpg',
              bio: 'Jon started out playing sax and clarinet throughout school, before packing that in for a while and messing around with turntables and sequencers.',
            },
            {
              name: 'Kevin Ribbans',
              position: 'producer, samples',
              img: '/images/band/kevin.jpg',
              bio: 'Kevin grew up under the watchful eye of a mother who happened to be a concert pianist. He runs the heart of the band — the Ableton Live based electronic setup.',
            },
            {
              name: 'EJ von Lyrik',
              position: 'vocalist',
              img: '/images/band/ej.jpg',
              bio: 'EJ started out with the hip hop group Godessa. She moved onto a successful solo career before deciding to lend her considerable talents to Mix n Blend.',
            },
            {
              name: 'Crosby Bolani',
              position: 'vocalist',
              img: '/images/band/crosby.jpg',
              bio: "One of South Africa's greatest toasters, Crosby a.k.a Digianolog is straight out of Gugs.",
            },
            {
              name: 'Lee Thomson',
              position: 'trumpet',
              img: '/images/band/lee.jpg',
              bio: 'Lee aka "Lee Lips" Thomson is one of the most versatile horn players and musical personalities in this country. Member of veteran punk band Hog Hoggidy Hog and jazz-electronic outfit Closet Snare.',
            },
            {
              name: 'Ross McDonald',
              position: 'trombone',
              img: '/images/band/ross-mcdonald.jpg',
              bio: "Ross 'Da Bone' McDonald. He plays in Hog Hoggidy Hog and the Rudimentals aside from Mix n Blend, and runs the amazing studio Hey Papa Legend. In his spare time he pursues his other passion: beard growing.",
            },
            {
              name: 'Callum McDonald',
              position: 'guitarist',
              img: '/images/band/callum.jpg',
              bio: 'One of the youngest people ever to grace the stage of Rocking the Daisies, a man with a complete obsession for guitar, bass and gaming.',
            },
            {
              name: 'Inka Kendzia',
              position: 'VJ',
              img: '/images/band/inka.jpg',
              bio: "One of Cape Town and South Africa's foremost visual artists. Loves to nerd out on new tech, runs post production company MEME in Cape Town, and often beats Jon in spontaneous dance-offs.",
            },
            {
              name: 'Sean Ou Tim',
              position: 'drums',
              img: '/images/band/sean.jpg',
              bio: "Sean a.k.a Mr. Sakitumi. Has played in so many outfits down the years it's hard to know where to begin.",
            },
          ].map((member) => (
            <div class="overflow-hidden rounded-card bg-white/10 backdrop-blur-sm">
              <img
                src={member.img}
                alt={`${member.name} — ${member.position}`}
                class="aspect-square w-full object-cover"
                loading="lazy"
              />
              <div class="p-5">
                <h3 class="font-display text-xl font-bold lowercase text-brand-yellow">
                  {member.name}
                </h3>
                <p class="mt-1 text-sm font-semibold uppercase tracking-wide text-white/60">
                  {member.position}
                </p>
                <p class="mt-3 text-sm leading-relaxed text-white/90">{member.bio}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <WaveDivider color="off-white" />

  <section class="bg-brand-off-white py-16">
    <div class="container mx-auto px-4">
      <div class="mx-auto max-w-3xl text-center">
        <h2 class="font-display mb-6 text-4xl font-bold lowercase text-brand-red">
          sounds like...
        </h2>
        <p class="font-body mb-8 text-lg leading-relaxed text-brand-dark">
          Whatever feels right. Genre tags are a bit of a necessary evil but if you need them, here
          you go:
        </p>
        <div class="flex flex-wrap justify-center gap-3 text-sm font-semibold">
          {
            [
              { label: 'electronic', color: 'bg-brand-blue text-white' },
              { label: 'nu disco', color: 'bg-brand-red text-white' },
              { label: 'disco', color: 'bg-brand-coral text-white' },
              { label: 'drum n bass', color: 'bg-brand-purple text-white' },
              { label: 'funk', color: 'bg-brand-yellow text-brand-dark' },
              { label: 'reggae', color: 'bg-brand-teal text-white' },
              { label: 'swing', color: 'bg-brand-red text-white' },
              { label: 'glitch hop', color: 'bg-brand-blue text-white' },
              { label: 'dub', color: 'bg-brand-purple text-white' },
            ].map((genre) => (
              <span class={`rounded-full px-4 py-2 ${genre.color}`}>{genre.label}</span>
            ))
          }
        </div>
      </div>
    </div>
  </section>
</Layout>
