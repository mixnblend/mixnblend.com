---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Hero from '../components/sections/Hero.astro';
import AppleMusicEmbed from '../components/ui/AppleMusicEmbed.astro';
import WaveDivider from '../components/ui/WaveDivider.astro';
import StreamingLinks from '../components/ui/StreamingLinks.astro';

const releases = await getCollection('releases');
const embeddable = releases
  .filter((r) => r.data.streamingLinks?.apple)
  .sort((a, b) => b.data.year - a.data.year);
---

<Layout
  title="Listen - Mix n Blend"
  description="Listen to Mix n Blend on Apple Music, Bandcamp, SoundCloud, and Spotify. Stream our music now."
>
  <Hero
    title="listen"
    subtitle="Stream our music"
    height="medium"
    backgroundImage="/src/assets/images/band/listen-hero.jpg"
  />

  <WaveDivider color="white" />

  <section class="bg-white py-16">
    <div class="container mx-auto px-4">
      <h2 class="font-display mb-12 text-center text-4xl font-bold lowercase text-brand-blue">
        all releases
      </h2>

      <div class="mx-auto max-w-3xl space-y-10">
        {
          embeddable.map((release) => (
            <div>
              <h3 class="font-display mb-3 text-xl font-bold lowercase text-brand-dark">
                {release.data.title}
                <span class="ml-2 text-sm font-normal text-gray-500">{release.data.year}</span>
              </h3>
              <AppleMusicEmbed
                url={release.data.streamingLinks!.apple!}
                title={release.data.title}
              />
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <WaveDivider color="blue" flip={true} />

  <section class="bg-brand-blue py-16">
    <div class="container mx-auto px-4 text-center">
      <h2 class="font-display mb-6 text-4xl font-bold lowercase text-white">stream everywhere</h2>
      <p class="mb-8 text-xl text-white/90">Find us on all major streaming platforms</p>
      <div class="flex justify-center">
        <StreamingLinks
          links={{
            apple: 'https://music.apple.com/za/artist/mix-n-blend/285190899',
            bandcamp: 'https://mixnblend.bandcamp.com',
            soundcloud: 'https://soundcloud.com/mixnblend',
          }}
          size="large"
        />
      </div>
    </div>
  </section>

  <WaveDivider color="off-white" flip={true} />

  <section class="bg-brand-off-white py-16">
    <div class="container mx-auto px-4 text-center">
      <h2 class="font-display mb-6 text-4xl font-bold lowercase text-brand-red">
        explore our discography
      </h2>
      <p class="font-body mb-8 text-lg text-brand-dark">
        From the debut album "Look Mom No Hands" to our latest releases
      </p>
      <a
        href="/music/"
        class="inline-block rounded-full bg-brand-blue px-8 py-3 font-display font-semibold lowercase text-white transition-all hover:scale-105 hover:bg-brand-purple"
      >
        View all music
      </a>
    </div>
  </section>
</Layout>
