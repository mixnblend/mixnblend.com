---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/sections/Hero.astro';
import BandcampEmbed from '../components/ui/BandcampEmbed.astro';
import WaveDivider from '../components/ui/WaveDivider.astro';
import StreamingLinks from '../components/ui/StreamingLinks.astro';
---

<Layout
  title="Listen - Mix n Blend"
  description="Listen to Mix n Blend on Bandcamp, SoundCloud, Apple Music, and Spotify. Stream our music now."
>
  <Hero title="listen" subtitle="Stream our music" height="small" />

  <WaveDivider color="white" />

  <section class="bg-white py-16">
    <div class="container mx-auto px-4">
      <h2 class="font-display mb-8 text-center text-4xl font-bold lowercase text-brand-blue">
        featured tracks
      </h2>

      <div class="mx-auto max-w-3xl space-y-8">
        <div>
          <h3 class="font-display mb-4 text-2xl font-bold lowercase text-brand-red">
            You Can (2016)
          </h3>
          <BandcampEmbed trackId="3405298534" title="You Can" size="small" />
        </div>
      </div>
    </div>
  </section>

  <WaveDivider color="teal" flip={true} />

  <section class="bg-brand-teal py-16">
    <div class="container mx-auto px-4">
      <h2 class="font-display mb-8 text-center text-4xl font-bold lowercase text-white">
        full albums on bandcamp
      </h2>

      <div class="mx-auto max-w-3xl space-y-12">
        <div>
          <h3 class="font-display mb-4 text-2xl font-bold lowercase text-brand-yellow">
            Rebel Gun / Mercy (2014)
          </h3>
          <div class="overflow-hidden rounded-card bg-white">
            <iframe
              style="border: 0; width: 100%; height: 120px;"
              src="https://bandcamp.com/EmbeddedPlayer/album=811486833/size=large/bgcol=ffffff/linkcol=1A5DAB/tracklist=false/artwork=small/transparent=true/"
              seamless
              title="Rebel Gun / Mercy on Bandcamp"
              loading="lazy"
            >
            </iframe>
          </div>
        </div>
      </div>
    </div>
  </section>

  <WaveDivider color="blue" />

  <section class="bg-brand-blue py-16">
    <div class="container mx-auto px-4 text-center">
      <h2 class="font-display mb-6 text-4xl font-bold lowercase text-white">stream everywhere</h2>
      <p class="mb-8 text-xl text-white/90">Find us on all major streaming platforms</p>
      <div class="flex justify-center">
        <StreamingLinks
          links={{
            appleMusic: 'https://music.apple.com/za/artist/mix-n-blend/285190899',
            bandcamp: 'https://mixnblend.bandcamp.com',
            soundcloud: 'https://soundcloud.com/mixnblend',
          }}
          size="large"
        />
      </div>
    </div>
  </section>

  <WaveDivider color="off-white" flip={true} />

  <section class="bg-brand-off-white py-16">
    <div class="container mx-auto px-4 text-center">
      <h2 class="font-display mb-6 text-4xl font-bold lowercase text-brand-red">
        explore our discography
      </h2>
      <p class="font-body mb-8 text-lg text-brand-dark">
        From the debut album "Look Mom No Hands" to our latest releases
      </p>
      <a
        href="/music/"
        class="inline-block rounded-full bg-brand-blue px-8 py-3 font-display font-semibold lowercase text-white transition-all hover:scale-105 hover:bg-brand-purple"
      >
        View all music
      </a>
    </div>
  </section>
</Layout>
