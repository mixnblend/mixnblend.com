---
import Button from '../ui/Button.astro';

interface Props {
  title: string;
  subtitle?: string;
  backgroundImage?: string;
  ctaText?: string;
  ctaLink?: string;
  height?: 'small' | 'medium' | 'large';
}

const { title, subtitle, backgroundImage, ctaText, ctaLink, height = 'large' } = Astro.props;

const heightClasses = {
  small: 'h-64 md:h-80',
  medium: 'h-80 md:h-96',
  large: 'h-96 md:h-[32rem]',
};
---

<section
  class:list={[
    'relative flex items-center justify-center',
    heightClasses[height],
    backgroundImage && 'bg-cover bg-center',
  ]}
  style={backgroundImage ? `background-image: url(${backgroundImage})` : undefined}
>
  <div class="absolute inset-0 bg-gradient-to-b from-black/60 to-black/40"></div>

  <div class="container relative z-10 mx-auto px-4 text-center text-white">
    <h1 class="font-display text-5xl font-bold lowercase md:text-6xl lg:text-7xl drop-shadow-lg">
      {title}
    </h1>
    {
      subtitle && (
        <p class="mt-6 font-body text-xl md:text-2xl lg:text-3xl font-medium drop-shadow-md">
          {subtitle}
        </p>
      )
    }
    {
      ctaText && ctaLink && (
        <div class="mt-10">
          <Button href={ctaLink} variant="primary" size="large">
            {ctaText}
          </Button>
        </div>
      )
    }
    <slot />
  </div>
</section>
