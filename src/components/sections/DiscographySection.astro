---
import { getCollection } from 'astro:content';
import AlbumCard from '../ui/AlbumCard.astro';

interface Props {
  limit?: number;
  filterType?: 'album' | 'single' | 'ep';
}

const { limit, filterType } = Astro.props;

let releases = await getCollection('releases');

if (filterType) {
  releases = releases.filter((release) => release.data.type === filterType);
}

releases = releases.sort((a, b) => b.data.releaseDate.getTime() - a.data.releaseDate.getTime());

if (limit) {
  releases = releases.slice(0, limit);
}
---

<section class="py-16 bg-gray-50">
  <div class="container mx-auto px-4">
    <h2 class="text-3xl font-bold text-center mb-12">Discography</h2>
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
      {
        releases.map((release) => (
          <AlbumCard
            title={release.data.title}
            type={release.data.type}
            releaseDate={release.data.releaseDate}
            artwork={release.data.artwork}
            slug={release.slug}
            streamingLinks={release.data.streamingLinks}
          />
        ))
      }
    </div>
  </div>
</section>
