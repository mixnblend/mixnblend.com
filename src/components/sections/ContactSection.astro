---
import SocialLinks from '../ui/SocialLinks.astro';

const socialPlatforms = [
  { name: 'Facebook', url: 'https://www.facebook.com/mixnblend' },
  { name: 'Discogs', url: 'https://www.discogs.com/artist/1358150-Mix-N-Blend' },
];
---

<section class="py-16">
  <div class="container mx-auto px-4">
    <div class="max-w-2xl mx-auto text-center">
      <h2 class="text-3xl font-bold mb-6">Get In Touch</h2>
      <p class="text-lg text-gray-600 mb-8">
        For booking inquiries, press information, or general questions, connect with us on social
        media.
      </p>

      <div class="mb-8">
        <h3 class="text-xl font-semibold mb-4">Follow Us</h3>
        <div class="flex justify-center">
          <SocialLinks platforms={socialPlatforms} size="large" />
        </div>
      </div>

      <div class="rounded-lg bg-gray-50 p-6">
        <h3 class="text-lg font-semibold mb-2">Booking Inquiries</h3>
        <p class="text-gray-600">
          For booking and collaboration opportunities, please reach out via our social media
          channels.
        </p>
      </div>
    </div>
  </div>
</section>
