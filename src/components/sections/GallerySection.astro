---
interface Props {
  images: Array<{ src: string; alt: string }>;
  columns?: number;
}

const { images, columns = 4 } = Astro.props;

const columnClasses: Record<number, string> = {
  2: 'grid-cols-1 sm:grid-cols-2',
  3: 'grid-cols-1 sm:grid-cols-2 lg:grid-cols-3',
  4: 'grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4',
};
---

<section class="py-16 bg-gray-50">
  <div class="container mx-auto px-4">
    <h2 class="text-3xl font-bold text-center mb-12">Gallery</h2>
    <div class:list={['grid gap-4', columnClasses[columns]]}>
      {
        images.map((image) => (
          <div class="overflow-hidden rounded-lg shadow-md hover:shadow-lg transition-shadow">
            <img
              src={image.src}
              alt={image.alt}
              class="h-full w-full object-cover aspect-square hover:scale-105 transition-transform"
              loading="lazy"
            />
          </div>
        ))
      }
    </div>
  </div>
</section>
