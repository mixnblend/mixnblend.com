---
interface Props {
  content: string;
  image?: string;
  imageAlt?: string;
  reverse?: boolean;
}

const { content, image, imageAlt = 'Mix n Blend', reverse = false } = Astro.props;
---

<section class="py-16">
  <div class="container mx-auto px-4">
    <div
      class:list={[
        'grid gap-8 md:grid-cols-2 md:gap-12 items-center',
        reverse && 'md:grid-flow-dense',
      ]}
    >
      {
        image && (
          <div class:list={['', reverse && 'md:col-start-2']}>
            <img src={image} alt={imageAlt} class="rounded-lg shadow-lg w-full" loading="lazy" />
          </div>
        )
      }
      <div class:list={['prose prose-lg max-w-none', reverse && 'md:col-start-1']}>
        <div set:html={content} />
      </div>
    </div>
  </div>
</section>
