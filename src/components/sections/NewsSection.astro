---
import { getCollection } from 'astro:content';
import NewsCard from '../ui/NewsCard.astro';

interface Props {
  limit?: number;
}

const { limit } = Astro.props;

let newsArticles = await getCollection('news');

newsArticles = newsArticles.sort(
  (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime()
);

if (limit) {
  newsArticles = newsArticles.slice(0, limit);
}
---

<section class="py-16">
  <div class="container mx-auto px-4">
    <h2 class="text-3xl font-bold text-center mb-12">Latest News</h2>
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        newsArticles.map((article) => (
          <NewsCard
            title={article.data.title}
            publishDate={article.data.publishDate}
            excerpt={article.data.excerpt}
            image={article.data.image}
            slug={article.slug}
          />
        ))
      }
    </div>
  </div>
</section>
