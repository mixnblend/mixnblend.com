---
interface Props {
  platforms: Array<{
    name: string;
    url: string;
    icon?: string;
  }>;
  size?: 'small' | 'medium' | 'large';
}

const { platforms, size = 'medium' } = Astro.props;

const sizeClasses = {
  small: 'text-sm',
  medium: 'text-base',
  large: 'text-lg',
};
---

<div class="flex flex-wrap gap-3">
  {
    platforms.map((platform, index) => {
      const colors = [
        'bg-brand-red hover:bg-brand-coral',
        'bg-brand-blue hover:bg-brand-purple',
        'bg-brand-teal hover:bg-brand-blue',
        'bg-brand-yellow hover:bg-brand-coral text-brand-dark',
        'bg-brand-coral hover:bg-brand-red',
        'bg-brand-purple hover:bg-brand-blue',
      ];
      const colorClass = colors[index % colors.length];

      return (
        <a
          href={platform.url}
          target="_blank"
          rel="noopener noreferrer"
          class:list={[
            'rounded-full px-4 py-2 font-semibold text-white transition-all hover:scale-105',
            colorClass,
            sizeClasses[size],
          ]}
          aria-label={platform.name}
        >
          {platform.name}
        </a>
      );
    })
  }
</div>
