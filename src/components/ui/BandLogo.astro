---
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<div class={`flex items-center gap-3 ${className}`}>
  <img
    src="/images/logo.png"
    alt="Mix n Blend logo"
    width="48"
    height="48"
    class="h-12 w-12 object-contain"
  />
  <span class="font-display text-2xl font-bold lowercase text-brand-dark">mix n blend</span>
</div>
