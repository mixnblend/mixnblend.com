---
import { formatDate } from '../../utils/formatDate';

interface Props {
  title: string;
  type: 'album' | 'single' | 'ep';
  releaseDate: Date;
  artwork: string;
  slug: string;
  streamingLinks?: {
    spotify?: string;
    apple?: string;
    bandcamp?: string;
    youtube?: string;
  };
}

const { title, type, releaseDate, artwork, slug, streamingLinks } = Astro.props;

const typeLabels = {
  album: 'Album',
  single: 'Single',
  ep: 'EP',
};
---

<article
  class="group overflow-hidden rounded-lg border border-gray-200 bg-white shadow-sm transition-shadow hover:shadow-md"
>
  <a href={`/music/${slug}`} class="block overflow-hidden">
    <img
      src={artwork}
      alt={`${title} artwork`}
      class="aspect-square w-full object-cover transition-transform group-hover:scale-105"
      loading="lazy"
    />
  </a>
  <div class="p-4">
    <span class="text-xs font-semibold uppercase tracking-wide text-primary">
      {typeLabels[type]}
    </span>
    <h3 class="mt-1 text-lg font-bold text-gray-900">
      <a href={`/music/${slug}`} class="hover:text-primary transition-colors">
        {title}
      </a>
    </h3>
    <time datetime={releaseDate.toISOString()} class="mt-1 block text-sm text-gray-500">
      {formatDate(releaseDate)}
    </time>
    {
      streamingLinks && Object.keys(streamingLinks).length > 0 && (
        <div class="mt-3 flex gap-2">
          {streamingLinks.spotify && (
            <a
              href={streamingLinks.spotify}
              target="_blank"
              rel="noopener noreferrer"
              class="text-xs text-gray-600 hover:text-primary transition-colors"
              aria-label="Listen on Spotify"
            >
              Spotify
            </a>
          )}
          {streamingLinks.apple && (
            <a
              href={streamingLinks.apple}
              target="_blank"
              rel="noopener noreferrer"
              class="text-xs text-gray-600 hover:text-primary transition-colors"
              aria-label="Listen on Apple Music"
            >
              Apple
            </a>
          )}
          {streamingLinks.bandcamp && (
            <a
              href={streamingLinks.bandcamp}
              target="_blank"
              rel="noopener noreferrer"
              class="text-xs text-gray-600 hover:text-primary transition-colors"
              aria-label="Listen on Bandcamp"
            >
              Bandcamp
            </a>
          )}
          {streamingLinks.youtube && (
            <a
              href={streamingLinks.youtube}
              target="_blank"
              rel="noopener noreferrer"
              class="text-xs text-gray-600 hover:text-primary transition-colors"
              aria-label="Watch on YouTube"
            >
              YouTube
            </a>
          )}
        </div>
      )
    }
  </div>
</article>
