---
import SocialLinks from '../ui/SocialLinks.astro';
import WaveDivider from '../ui/WaveDivider.astro';

const currentYear = new Date().getFullYear();

const socialLinks = [
  { name: 'Facebook', url: 'https://www.facebook.com/mixnblend/' },
  { name: 'Instagram', url: 'https://www.instagram.com/mixnblendyo/' },
  { name: 'Bandcamp', url: 'https://mixnblend.bandcamp.com' },
  { name: 'SoundCloud', url: 'https://soundcloud.com/mixnblend' },
  { name: 'Apple Music', url: 'https://music.apple.com/za/artist/mix-n-blend/285190899' },
  { name: 'Twitter', url: 'https://twitter.com/mixnblendyo' },
];
---

<WaveDivider color="teal" />
<footer class="bg-brand-teal py-12">
  <div class="container mx-auto px-4">
    <div class="flex flex-col items-center gap-8">
      <div class="text-center">
        <h2 class="font-display text-3xl font-bold lowercase text-white">connect with us</h2>
        <p class="mt-2 text-white/90">Electronic band from Cape Town</p>
      </div>

      <SocialLinks platforms={socialLinks} size="small" />

      <div class="mt-4 text-center">
        <p class="font-body text-sm text-white/80">
          &copy; {currentYear} Mix n Blend. All rights reserved.
        </p>
        <p class="mt-1 text-xs text-white/70">Double SAMA nominated act</p>
      </div>
    </div>
  </div>
</footer>
