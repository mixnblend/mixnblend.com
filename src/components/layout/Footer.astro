---
const currentYear = new Date().getFullYear();

const socialLinks = [
  { name: 'Facebook', url: 'https://www.facebook.com/mixnblend', icon: 'facebook' },
  { name: 'Discogs', url: 'https://www.discogs.com/artist/1358150-Mix-N-Blend', icon: 'discogs' },
];
---

<footer class="border-t border-gray-200 bg-gray-50 py-8">
  <div class="container mx-auto px-4">
    <div class="flex flex-col items-center gap-6 md:flex-row md:justify-between">
      <div class="text-center md:text-left">
        <p class="text-gray-700">
          &copy; {currentYear} Mix n Blend. All rights reserved.
        </p>
        <p class="mt-2 text-sm text-gray-500">Double SAMA nominated act</p>
      </div>

      <div class="flex gap-4">
        {
          socialLinks.map((link) => (
            <a
              href={link.url}
              target="_blank"
              rel="noopener noreferrer"
              class="text-gray-700 transition-colors hover:text-primary"
              aria-label={link.name}
            >
              <span class="text-sm font-medium">{link.name}</span>
            </a>
          ))
        }
      </div>
    </div>
  </div>
</footer>
