---
interface Props {
  links: Array<{ href: string; label: string }>;
  currentPath: string;
}

const { links, currentPath } = Astro.props;
---

<nav aria-label="Main navigation">
  <ul class="flex flex-col gap-4 md:flex-row md:gap-6">
    {
      links.map((link) => {
        const isActive =
          currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));
        return (
          <li>
            <a
              href={link.href}
              class:list={[
                'font-display text-lg font-semibold lowercase transition-colors hover:text-brand-red',
                isActive ? 'text-brand-blue' : 'text-brand-dark',
              ]}
              aria-current={isActive ? 'page' : undefined}
            >
              {link.label}
            </a>
          </li>
        );
      })
    }
  </ul>
</nav>
