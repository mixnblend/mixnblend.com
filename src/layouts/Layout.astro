---
import '../styles/global.css';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
}

const {
  title,
  description = 'Mix n Blend - South African music collective creating a uniquely South African sound. Double SAMA nominated act.',
  image = '/images/og-default.jpg',
  type = 'website',
} = Astro.props;

const siteUrl = 'https://www.mixnblend.com';
const currentPath = Astro.url.pathname;
const canonicalURL = new URL(currentPath, siteUrl);

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'MusicGroup',
  name: 'Mix n Blend',
  genre: ['Reggae', 'Hip Hop', 'Jazz', 'Funk', 'Dubstep'],
  description:
    'South African music collective creating a uniquely South African sound. Double SAMA nominated act.',
  url: siteUrl,
  sameAs: [
    'https://www.facebook.com/mixnblend',
    'https://www.discogs.com/artist/1358150-Mix-N-Blend',
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="canonical" href={canonicalURL} />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, siteUrl)} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(image, siteUrl)} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body class="flex min-h-screen flex-col">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:top-0 focus:left-0 focus:z-50 focus:bg-white focus:p-4"
    >
      Skip to main content
    </a>

    <Header currentPath={currentPath} />

    <main id="main-content" class="flex-1">
      <slot />
    </main>

    <Footer />
  </body>
</html>
